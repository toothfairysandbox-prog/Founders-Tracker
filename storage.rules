rules_version = '2';

// Note attachments — only the listed accounts can read or write.
//
// These addresses must match firestore.rules and the MEMBERS map at the top of
// js/goals.js. Change one, change all three.
//
// Publish from the Firebase console: Storage → Rules → Publish. This file does
// NOT deploy when you push to GitHub.
service firebase.storage {
  match /b/{bucket}/o {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'samuelgibby89@gmail.com',
             'garrettwoodhouse@gmail.com',
             'toothfairysandbox@gmail.com'
           ];
    }

    // Everything the app writes lives under notes/<noteId>/.
    match /notes/{noteId}/{fileName} {
      allow read: if isMember();
      // Same ceiling the app enforces, restated here so a hand-crafted request
      // can't push a 2 GB file into the bucket and eat the free allowance.
      allow write: if isMember() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isMember();
    }

    // Nothing else in the bucket is reachable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
